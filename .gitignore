# iOS — support was removed, but Flutter
# still leaves a generated scaffold in app/ios/. These rules keep it out of git; the
# Config/ rules also stop a GoogleService-Info.plist landing there.
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/**/GeneratedPluginRegistrant.*
**/ios/Config/*
**/ios/Config/**/*
**/ios/Runner/GoogleService-Info.plist

# Archives and raw audio
*.zip
*.wav

# Source export generated by scripts/zip-source.py
/sourcezips/
/memrii-source.zip
/memrii-source-app-*-fw-*.zip

# ...except the consumer hardware manufacturing package. The Gerbers, Altium
# sources and CNC finish spec ship as .zip and are design SOURCE, not build
# output — the blanket *.zip above silently dropped all eight on import, leaving
# electrical/ with schematic PDFs and nothing orderable. They verify against
# omi/hardware/consumer/checksums.sha256.
!omi/hardware/consumer/**/*.zip

# Local-only — not tracked
# Engineering notes and task reports stay local; public usage/build guidance is in README.md.
/docs/
# Root agent instructions remain discoverable locally, outside public source exports.
/CLAUDE.md
/CLAUDE.local.md
# Keep future root copies of internal planning/debugging notes local too.
/IDEAS.md
/NOTES.md
# Owner build wrappers and source-export tooling remain runnable locally.
/scripts/
# Private developer entry points, entitlement providers, launchers and artifacts.
/app/local_development/
/version.txt
/REFACTORING_INSTRUCTIONS.md
/diff.patch
/test_codec.dart
LOCAL_DEV_SETUP.md
.claude/settings.json
.claude/settings.local.json
.claude/projects/
.claude/worktrees/
.claude/
app/.claude/
app/.metadata
.backups/

# Generated browser snapshots (contain PII)
builds-snapshot.md
*-snapshot.md

# Generated APK and firmware release artifacts
/releases/

# Exported Omi bin archives and shared debug logs — real recorded audio and
# device logs pulled off a phone for analysis. Never commit these.
# (omi_bins_ from omi-offline builds, memrii_bins_ from memrii builds.)
omi_bins_*/
memrii_bins_*/
logs/

